---
import Layout from "@/layouts/Layout.astro";
import MomentsFeed from "@/components/moments/MomentsFeed.svelte";
import themeConfig from "@/theme.config";

const pageTitle = "动态";
---

<Layout pageTitle={pageTitle} indexPage={true}>
  <Fragment slot="head">
    <meta name="description" content="动态 - 记录生活的点滴" />
  </Fragment>

  <MomentsFeed client:load feed={themeConfig.momentsFeed} />
</Layout>
