---
import { fetchTweetPreview } from "@/toolkit/twitter";

interface Props {
  id: string;
}

const { id } = Astro.props;
const preview = await fetchTweetPreview(id);
const href = preview.url;
const displayName = preview.authorName || preview.authorHandle || "X";
const handleLabel = preview.authorHandle ? `@${preview.authorHandle}` : "";
const avatarFallback = displayName.slice(0, 1);
const mediaCount = Math.min(preview.media.length, 4);
const media = preview.media.slice(0, 4);
const metaParts = [handleLabel, preview.createdAt].filter(Boolean);
---

<figure class="tweet-card" data-tweet-id={id}>
  <a class="tweet-card__link" href={href} target="_blank" rel="noopener noreferrer">
    <div class="tweet-card__header">
      {
        preview.avatarUrl ? (
          <img
            class="tweet-card__avatar"
            src={preview.avatarUrl}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            data-tweet-media
          />
        ) : (
          <span class="tweet-card__avatar tweet-card__avatar--fallback" aria-hidden="true">
            {avatarFallback}
          </span>
        )
      }
      <div class="tweet-card__author">
        <div class="tweet-card__name">{displayName}</div>
        {metaParts.length > 0 ? <div class="tweet-card__meta">{metaParts.join(" · ")}</div> : null}
      </div>
      <i class="i-ri-twitter-x-line tweet-card__brand" aria-hidden="true"></i>
    </div>

    {
      preview.text ? (
        <p class="tweet-card__text">{preview.text}</p>
      ) : (
        <p class="tweet-card__text tweet-card__text--empty">打开这条 X 帖子</p>
      )
    }

    {
      mediaCount > 0 ? (
        <div class={`tweet-card__media tweet-card__media--count-${mediaCount}`}>
          {media.map((item) => (
            <div
              class:list={[
                "tweet-card__media-item",
                item.type === "video" && "tweet-card__media-item--video",
              ]}
            >
              <img
                src={item.url}
                alt=""
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                data-tweet-media
              />
            </div>
          ))}
        </div>
      ) : null
    }

    <div class="tweet-card__footer">在 X 上查看</div>
  </a>
</figure>
